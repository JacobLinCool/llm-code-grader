{
    "name": "code-grader-core",
    "version": "0.0.0",
    "description": "Core library for LLM-based code grading",
    "author": "JacobLinCool <jacoblincool@gmail.com> (https://github.com/JacobLinCool)",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/JacobLinCool/llm-code-grader.git",
        "directory": "packages/code-grader-core"
    },
    "homepage": "https://github.com/JacobLinCool/llm-code-grader#readme",
    "bugs": {
        "url": "https://github.com/JacobLinCool/llm-code-grader/issues"
    },
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist"
    ],
    "keywords": [
        "code-grader",
        "llm",
        "grading",
        "ai"
    ],
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch"
    },
    "packageManager": "pnpm@10.18.0",
    "peerDependencies": {
        "@google/genai": "^1.28.0"
    },
    "devDependencies": {
        "@types/node": "^24.10.0",
        "tsup": "^8.5.0",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3"
    }
}
